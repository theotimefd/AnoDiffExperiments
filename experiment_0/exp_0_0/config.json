{
    "experiment_name": "experiment_0",
    "sub_experiment_name": "exp_0_0",
    "description": "2D DDPM on flair with simplex noise",
    "spatial_dims": 2,
    "image_size": 128,
    "root_dir":"/bettik/PROJECTS/pr-gin5_aini/fehrdelt/",
    "dataset":{
        "name": "final_flair_dataset_small",
        "batch_size": 32,
        "num_workers": 16
    },
    "train_transforms": {
        "_target_": "monai.transforms.Compose",
        "transforms": [
        {
            "_target_": "monai.transforms.LoadImage", "image_only": true
        },
        {
            "_target_": "monai.transforms.EnsureChannelFirst"
        },
        {
            "_target_": "monai.transforms.RandAffine", "prob": 0.5, "rotate_range": [0.1, 0.1, 0.1]
        },
        {
            "_target_": "utils.custom_transforms.Get2DSliceWithRandomOffset", "axis": 2, "fixed_offset": 0, "range_offset": 10
        },
        {
            "_target_": "monai.transforms.RandScaleCrop", "roi_scale":0.9, "max_roi_scale":1.1, "random_size":true
        },
        {
            "_target_": "monai.transforms.ResizeWithPadOrCrop", "spatial_size":["@image_size", "@image_size"]
        },
        {
            "_target_": "utils.custom_transforms.ScaleIntensityFromHistogramPeak", "target_value": 200.0
        },
        {
            "_target_": "monai.transforms.ScaleIntensityRange", "a_min":0.0, "a_max":450.0, "b_min":0.0, "b_max":1.0, "clip":true
        },
        {
            "_target_": "monai.transforms.RandFlip", "prob": 0.5, "spatial_axis": 0
        },
        {
            "_target_": "utils.custom_transforms.SetBackgroundToZero"
        }]
    },
    "val_transforms": {
        "_target_": "monai.transforms.Compose",
        "transforms": [
            {
                "_target_": "monai.transforms.LoadImage", "image_only": true
            },
            {
                "_target_": "monai.transforms.EnsureChannelFirst"
            },
            {
                "_target_": "utils.custom_transforms.Get2DSlice", "axis": 2
            },
            {
                "_target_": "monai.transforms.ResizeWithPadOrCrop", "spatial_size":["@image_size", "@image_size"]
            },
            {
                "_target_": "utils.custom_transforms.ScaleIntensityFromHistogramPeak", "target_value": 200.0
            },
            {
                "_target_": "monai.transforms.ScaleIntensityRange", "a_min":0.0, "a_max":450.0, "b_min":0.0, "b_max":1.0, "clip":true
            },
            {
                "_target_": "utils.custom_transforms.SetBackgroundToZero"
            }
        ]
    },
    "noise": {
        "type": "simplex",
        "simplex_octaves":6, 
        "simplex_persistence":0.8, 
        "simplex_frequency":64,
        "num_train_timesteps": 600,
        "beta_start": 0.0015,
        "beta_end": 0.0195
    },
    "network_def": {
        "_target_": "monai.networks.nets.DiffusionModelUNet",
        "spatial_dims": "@spatial_dims",
        "in_channels": 1,
        "out_channels": 1,
        "channels":[128, 128, 256, 256],
        "attention_levels":[false, true, true, true],
        "num_head_channels":[0, 128, 128, 256]
    },
    "diffusion_train": {
        "enabled": true,
        "max_epochs": 50,
        "val_interval": 10,
        "optimizer": {
            "type": "Adam",
            "lr": 2e-5
        },
        "ema":true
    },
    "compute_metrics_reconstruction":{
        "enabled": true,
        "dataset": "final_flair_dataset_small",
        "transforms": {
            "transform_0":{
                "_target_": "transforms.LoadImage", "image_only": true
            },
            "transform_1":{
                "_target_": "transforms.EnsureChannelFirst"
            },
            "transform_3":{
                "_target_": "custom_transforms.Get2DSlice", "axis": 2
            },
            "transform_5":{
                "_target_": "transforms.ResizeWithPadOrCrop", "spatial_size":["@image_size", "@image_size"]
            },
            "transform_6":{
                "_target_": "custom_transforms.ScaleIntensityFromHistogramPeak", "target_value": 200.0
            },
            "transform_7":{
                "_target_": "transforms.ScaleIntensityRange", "a_min":0.0, "a_max":450.0, "b_min":0.0, "b_max":1.0, "clip":true
            },
            "transform_9":{
                "_target_": "custom_transforms.SetBackgroundToZero"
            }
        },
        "noise_timesteps_min": 300,
        "noise_timesteps_max": 600,
        "noise_interval": 50
    }
}
