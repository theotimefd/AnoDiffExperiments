{
    "spatial_dims": 2,
    "dataset":{
        "name": "final_flair_dataset_small",
        "train_transforms": {

        },
        "val_transforms": {

        }
    },
    "noise": {
        "type": "simplex",
        "simplex_octaves":6, 
        "simplex_persistence":0.8, 
        "simplex_frequency":64,
        "num_train_timesteps": 600,
        "beta_start": 0.0015,
        "beta_end": 0.0195
    },
    "network_params": {
        "spatial_dims": "@spatial_dims",
        "channels":[256, 256, 512],
        "attention_levels":[false, true, true],
        "num_head_channels":[0, 64, 64],
        "num_res_blocks": 2
    },
    "diffusion_train": {
        "batch_size": 70,
        "lr": 2e-5,
        "max_epochs": 10000,
        "val_interval": 10,
        "optimizer": {
            "type": "AdamW",
            "weight_decay": 0.0,
            "betas": [0.9, 0.999]
        },
        "ema":true
    }
}
